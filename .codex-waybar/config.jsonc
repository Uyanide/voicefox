{
    "include": [
        "/usr/share/zig-waybar-contrib/config.jsonc"
    ],
    "layer": "top",
    "position": "top",
    "height": 50,
    "spacing": 5,
    "fixed-center": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/logo",
        "niri/workspaces",
        "niri/window",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/weather",
        "privacy",
        "group/connectivity",
        "group/audio",
        "group/system",
        "battery",
        "tray",
        "custom/notification",
        "custom/power"
    ],

    "group/connectivity": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 180,
            "reveal-delay": 100,
            "children-class": "connectivity-child",
            "transition-left-to-right": false
        },
        "modules": [
            "network",
            "bluetooth"
        ]
    },
    "group/audio": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 180,
            "reveal-delay": 100,
            "children-class": "audio-child",
            "transition-left-to-right": false
        },
        "modules": [
            "wireplumber",
            "backlight"
        ]
    },
    "group/system": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 200,
            "reveal-delay": 120,
            "children-class": "system-child",
            "transition-left-to-right": false
        },
        "modules": [
            "custom/cpu",
            "custom/memory",
            "custom/disk",
            "power-profiles-daemon",
            "custom/updates"
        ]
    },

    "niri/workspaces": {
        "format": "{index}",
        "all-outputs": false,
        "enable-bar-scroll": false,
        "current-only": false,
        "workspace-taskbar": {
            "enable": true,
            "icon-size": 22
        }
    },
    "niri/window": {
        "format": "{title}",
        "max-length": 26,
        "separate-outputs": true,
        "icon": true,
        "icon-size": 16,
        "tooltip-format": "{app_id}\n{title}"
    },
    "mpris": {
        "format": "{player_icon}  {title}",
        "format-paused": "{status_icon}  {title}",
        "format-stopped": "",
        "status-icons": {
            "playing": "",
            "paused": ""
        },
        "player-icons": {
            "spotify": "",
            "firefox": "",
            "chromium": "",
            "default": ""
        },
        "ignored-players": [
            "playerctld"
        ],
        "interval": 1,
        "max-length": 18,
        "tooltip-format": "{player} · {status}\n{title}\n{artist} · {album}",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    "clock": {
        "interval": 1,
        "locale": "zh_CN.UTF-8",
        "format": "{:L%H:%M}",
        "format-alt": "{:L%m-%d %A  %H:%M:%S}",
        "tooltip-format": "<big>{:%Y 年 %m 月}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "first-day-of-week": 1,
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#6c7086'>W{}</span>",
                "weekdays": "<span color='#a6e3a1'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click": "exec gnome-clocks",
            "on-click-middle": "mode",
            "on-click-right": "exec gnome-calendar",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/weather": {
        "exec": "wttrbar --location=成都 --custom-indicator '{ICON} {temp_C}°'",
        "interval": 1800,
        "restart-interval": 60,
        "return-type": "json"
    },
    "network": {
        "format-wifi": "{icon}  {signalStrength}%",
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ],
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "format-alt": "{ifname}  {ipaddr}",
        "tooltip-format-wifi": "{essid}  {signalStrength}%\n↓ {bandwidthDownBytesCompact}/s   ↑ {bandwidthUpBytesCompact}/s\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}  {linkSpeed}\n↓ {bandwidthDownBytesCompact}/s   ↑ {bandwidthUpBytesCompact}/s\nIP: {ipaddr}",
        "tooltip-format-disconnected": "网络未连接",
        "tooltip-format-disabled": "无线网络已关闭",
        "interval": 30,
        "on-click": "nm-connection-editor",
        "on-click-right": "kitty --class network-tui --title 网络管理 ~/.config/waybar/scripts/select-network-tui.sh"
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "",
        "format-connected": "  {num_connections}",
        "format-no-controller": "",
        "format-connected-battery": "  {device_battery_percentage}%",
        "tooltip-format-disabled": "蓝牙已禁用",
        "tooltip-format-off": "蓝牙已关闭",
        "tooltip-format-on": "蓝牙已开启",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "• {device_alias}",
        "tooltip-format-enumerate-connected-battery": "• {device_alias}  {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "~/.config/waybar/scripts/toggle-bluetooth.sh"
    },
    "privacy": {
        "icon-spacing": 4,
        "icon-size": 16,
        "modules": [
            {
                "type": "screenshare",
                "tooltip": true
            },
            {
                "type": "audio-in",
                "tooltip": true
            },
            {
                "type": "audio-out",
                "tooltip": true
            }
        ]
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "nospacing": 1,
        "tooltip-format": "音量：{volume}%\n左键静音 · 右键混音器 · 滚轮调节",
        "format-muted": "󰝟  静音",
        "format-icons": {
            "headphone": "",
            "headset": "󰋎",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pamixer -t",
        "on-click-right": "pavucontrol",
        "scroll-step": 5
    },
    "backlight": {
        "device": "nvidia_wmi_ec_backlight",
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "tooltip-format": "屏幕亮度：{percent}%\n滚轮调节",
        "scroll-step": 5
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "电源模式：{profile}\n驱动：{driver}",
        "format-icons": {
            "default": "",
            "performance": "",
            "balanced": "",
            "power-saver": ""
        }
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/check-updates.sh",
        "restart-interval": 10,
        "return-type": "json",
        "format": "{icon} {text}",
        "format-icons": {
            "updated": "󰄬",
            "has-updates": "󰏔"
        },
        "on-click": "~/.config/waybar/scripts/command-center.sh",
        "on-click-right": "pkill -USR1 -f '[c]heck-updates.sh'"
    },
    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/zwc-cpu.sh",
        "restart-interval": 60,
        "return-type": "json",
        "signal": 13
    },
    "custom/memory": {
        "exec": "~/.config/waybar/scripts/zwc-memory.sh",
        "restart-interval": 60,
        "return-type": "json",
        "signal": 17
    },
    "custom/disk": {
        "exec": "~/.config/waybar/scripts/disk.sh",
        "restart-interval": 60,
        "return-type": "json",
        "signal": 14
    },
    "battery": {
        "bat": "BAT1",
        "adapter": "ACAD",
        "interval": 5,
        "smooth-power": true,
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 25,
            "critical": 12
        },
        "tooltip-format": "{timeTo}\n功耗：{power} W\n健康度：{health}% · 循环：{cycles}"
    },
    "tray": {
        "spacing": 5,
        "icon-size": 16,
        "show-passive-items": false,
        "ignore-list": [
            "nm_applet",
            "Network",
            "blueman",
            "cachy-update",
            "Arch-Update"
        ]
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon} {text}",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂚",
            "dnd-notification": "󰂛",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰂛",
            "dnd-inhibited-notification": "󰂛",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "command -v swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },
    "custom/logo": {
        "format": "",
        "tooltip-format": "应用程序\n左键启动器 · 右键命令中心",
        "on-click": "rofi -show drun -show-icons",
        "on-click-right": "~/.config/waybar/scripts/command-center.sh"
    },
    "custom/power": {
        "format": "",
        "tooltip-format": "电源菜单",
        "on-click": "wlogout"
    }
}
